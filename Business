.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.card{background:#fff;border-top:5px solid var(--n);padding:20px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,.08)}
